# Gemini API key. Required for the assistant; the rest of NEXUS runs without it.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Text model. Any streaming-capable Gemini model works.
# GEMINI_MODEL=gemini-2.5-flash

# Set to 1 to give the assistant Google Search grounding, so it can answer
# "how is Nvidia today" with real figures instead of declining. The route falls
# back to function calling alone if the model rejects the combination.
# GEMINI_GROUNDING=1

# High-quality spatialised speech. Set to 0 to force the browser's own
# SpeechSynthesis, which is instant and free but cannot be positioned in 3D.
# GEMINI_TTS=0
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore

# --- Phase 3: module data -------------------------------------------------

# Weather falls back to these when the browser will not share a location.
# NEXUS_LAT=48.8566
# NEXUS_LON=2.3522

# Portfolio positions as JSON. Prices are always live; only units and cost
# basis are local, because no public API knows those.
# NEXUS_PORTFOLIO=[{"symbol":"NVDA","name":"NVIDIA","sector":"Semiconductors","units":12,"costBasis":118.4}]

# Comma-separated RSS feeds. Defaults to four technology sources.
# NEXUS_NEWS_FEEDS=https://www.theverge.com/rss/index.xml,https://hnrss.org/frontpage

# TheSportsDB. "3" is the shared test key and returns limited data.
# NEXUS_SPORTSDB_KEY=3
# NEXUS_LEAGUE_ID=4328

# Calendar: the secret iCal address your calendar already publishes.
# Google Calendar: Settings, pick the calendar, "Secret address in iCal format".
# Treat it as a password.
# NEXUS_ICS_URL=

# Instagram. The account must be Professional or Creator first: a personal
# account returns no statistics from any API, whatever the token.
#
# Route A (recommended) - "Instagram API with Instagram Login". No Facebook Page
# needed; the token identifies the account. Set the token only.
# IG_GRAPH_TOKEN=
#
# Route B - Graph API via Facebook Login. Only if the Instagram account is
# linked to a Facebook PAGE (a personal profile does not count). Set both.
# INSTAGRAM_USER_ID=
# INSTAGRAM_TOKEN=
#
# Verify either route with:  npm run instagram:check

# Raises the GitHub rate limit for the Projects module from 60/hour.
# GITHUB_TOKEN=
